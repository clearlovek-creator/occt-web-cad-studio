# Local development
MODEL_AGENT_DATA_PATH=.data/agent-state.json

# Team/production persistence
# MODEL_AGENT_DATABASE_URL=postgresql+psycopg://user:password@localhost/modeling_agent

# Existing Node Gateway / OCCT Worker boundary
# MODEL_AGENT_GATEWAY_URL=http://127.0.0.1:8788

# Workflow engine: local deterministic mode or durable LangGraph mode
# MODEL_AGENT_WORKFLOW_ENGINE=langgraph
# MODEL_AGENT_CHECKPOINT_PATH=.data/langgraph-checkpoints.bin

# OpenAI-compatible model for the structured LLM Planner and bounded theory ReAct
# MODEL_AGENT_LLM_BASE_URL=http://127.0.0.1:4000/v1
# MODEL_AGENT_LLM_API_KEY=
# MODEL_AGENT_LLM_MODEL=your-model
