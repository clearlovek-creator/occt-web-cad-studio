include("${CMAKE_CURRENT_LIST_DIR}/ReadHeaderVersion.cmake")
foreach(component IN LISTS Boost_FIND_COMPONENTS)
  if(NOT component STREQUAL "headers" AND NOT component STREQUAL "boost")
    set(Boost_FOUND FALSE)
    set(Boost_NOT_FOUND_MESSAGE "Research adapter provides headers only, not ${component}")
    return()
  endif()
endforeach()
set(Boost_FOUND TRUE)
set(Boost_INCLUDE_DIRS "${CAD_RESEARCH_BOOST_INCLUDE}")
set(Boost_LIBRARIES "")
if(NOT TARGET Boost::boost)
  add_library(Boost::boost INTERFACE IMPORTED)
  set_target_properties(Boost::boost PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${Boost_INCLUDE_DIRS}")
endif()
