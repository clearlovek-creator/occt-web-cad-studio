# Development frontend gateway URL. Production build:release uses same-origin /api;
# its upstream is chosen at runtime by start-web-cad-demo.ps1 (-GatewayPort).
NEXT_PUBLIC_GEOMETRY_API_URL=http://127.0.0.1:8788/api

# Geometry gateway runtime
GEOMETRY_HOST=127.0.0.1
GEOMETRY_PORT=8788
# Default is .data under the project; use an explicit persistent directory if needed.
# GEOMETRY_DATA_DIR=D:/CADData/WebCAD
GEOMETRY_ALLOW_TEMP_DATA_FALLBACK=false
# Optional staged geometry worker binary for controlled upgrades
# GEOMETRY_WORKER_PATH=D:/CADRuntime/occt_geometry_worker.exe
GEOMETRY_PROJECT_LIMIT_BYTES=268435456
GEOMETRY_PROJECT_UNPACKED_LIMIT_BYTES=536870912
# Per-document replay window: at most 100 entries and 256 MiB serialized outcomes.
# Evicted request keys are not guaranteed replayable; do not blindly resend old edits.
GEOMETRY_IDEMPOTENCY_BYTES=268435456
# Aggregate serialized step results for one atomic batch (hard maximum 64 MiB).
GEOMETRY_BATCH_RESULT_BYTES=67108864
# Shared geometry-worker action admission: one complete engineering action at a time.
# Waiting actions only: global 1..256, per-document 1..64 (not above global),
# queue-only deadline 1..600000 ms. Does not cancel an executing transaction.
GEOMETRY_ACTION_QUEUE_LIMIT=64
GEOMETRY_ACTION_DOCUMENT_QUEUE_LIMIT=16
GEOMETRY_ACTION_QUEUE_TIMEOUT_MS=120000
# Aggregate serialized input held by waiting actions, not process heap/RSS.
# Project-open packages queue a 128-byte descriptor; package bytes are staged on disk.
GEOMETRY_ACTION_QUEUE_BYTES=67108864
WEB_ORIGIN=http://localhost:3000
# Modeling Agent provider security (optional; UI-managed providers are encrypted under GEOMETRY_DATA_DIR)
AGENT_CONFIG_SECRET=replace-with-a-long-random-secret
AGENT_ALLOW_PRIVATE_URL=false
AGENT_REQUEST_TIMEOUT_MS=120000
AGENT_RETRY_ATTEMPTS=2
AGENT_RETRY_DELAY_MS=1000
# LLM transport: native fetch first; auto falls back to curl.exe when Node is blocked by firewall/TLS policy
AGENT_HTTP_TRANSPORT=auto
AGENT_CURL_PATH=curl.exe
AGENT_DISABLE_CURL_FALLBACK=false

# Optional Agent resource directories (Markdown/TXT/JSON)
AGENT_SKILLS_DIR=.data/agent-skills
AGENT_KNOWLEDGE_DIR=.data/agent-knowledge

GEOMETRY_REQUEST_TIMEOUT_MS=600000
GEOMETRY_STEP_LIMIT_BYTES=209715200
GEOMETRY_WORKER_TIMEOUT_MS=600000
# Enforced Windows commit budget for the geometry worker and its own job.
# Bytes only, 128 MiB..8 GiB; 0/empty/unknown platform do not disable protection.
# This is not an RSS, total Gateway, mesh-worker or Pi memory limit.
GEOMETRY_WORKER_MEMORY_LIMIT_BYTES=2147483648
# Independent enforced commit cap for each Gmsh worker (including file tools).
# Same strict 128 MiB..8 GiB range; handshake refuses old/unprotected workers.
# Per-process/job only: not a combined CAD/Gateway/Pi/GPU or disk budget.
MESH_WORKER_MEMORY_LIMIT_BYTES=2147483648
# Logical mesh-root admission (not OS disk quota or physical reservation).
# Counts mesh-jobs (including caches), meshes and mesh-sources; never evicts data.
MESH_STORAGE_MAX_BYTES=68719476736
MESH_STORAGE_RESERVATION_BYTES=4294967296
MESH_STORAGE_MIN_FREE_BYTES=1073741824
# Native RPC admission budgets, separate from HTTP upload/body limits.
# Limits cap at 256 pending calls / 64 MiB pending / 8 MiB per native request.
GEOMETRY_WORKER_PENDING_REQUESTS=64
GEOMETRY_WORKER_PENDING_BYTES=16777216
GEOMETRY_WORKER_REQUEST_LIMIT_BYTES=4194304
# Explicit handshake deadline; default derives from worker timeout (5s minimum, 300s cap).
GEOMETRY_WORKER_STARTUP_TIMEOUT_MS=10000
# Stop verification caps at 30000 ms. A timeout is not proof of process exit.
GEOMETRY_WORKER_STOP_TIMEOUT_MS=5000
# Read-only XBF metadata helper (built together with the geometry worker).
# Never recomputes or restores the live CAD document. Optional custom absolute path:
# GEOMETRY_SOURCE_INSPECTOR_PATH=D:/Project/OCCT8.0/web-cad-demo/geometry-worker/build/cad_snapshot_source_inspector.exe
GEOMETRY_WORKER_RESPONSE_LIMIT_BYTES=268435456
# Managed shutdown: finish admitted document transactions, then verify owned worker exits.
# Grace is capped at 30000 ms; stop verification at 10000 ms. No automatic command replay.
GEOMETRY_SHUTDOWN_GRACE_MS=10000
GEOMETRY_SHUTDOWN_STOP_MS=5000
# Rebuildable quality cache only; original MSH/BREP/quality/render files are never auto-evicted.
GEOMETRY_MESH_CACHE_BYTES=4294967296
GEOMETRY_MESH_CACHE_JOB_BYTES=1073741824
GEOMETRY_MESH_MAX_JOBS=2000
GEOMETRY_MESH_MAX_JOBS_PER_DOCUMENT=500
OCCT_WEB_MESH_LINEAR_DEFLECTION=0.12
OCCT_WEB_MESH_ANGULAR_DEFLECTION=0.12
OCCT_WEB_MAX_TRIANGLES=250000
OCCT_WEB_MAX_EDGES=20000
# Use the face triangulation for curved edges. A positive value forces uniform samples.
OCCT_WEB_EDGE_SAMPLES=0
# Current workbench uses Pi RPC + CAD MCP through the geometry gateway.
# Historical Python client settings below are optional and do not switch the Pi panel.
# NEXT_PUBLIC_MODELING_AGENT_BACKEND=python
# NEXT_PUBLIC_MODELING_AGENT_API_URL=http://127.0.0.1:8090/api/v1/agent
# MODEL_AGENT_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
