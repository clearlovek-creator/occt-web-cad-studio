{
    "name": "occt-web-cad-demo",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
        "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
        "start": "node scripts/frontend-launch.mjs",
        "build:release": "node scripts/build-frontend-release.mjs",
        "build:backend": "node scripts/build-backend-release.mjs",
        "build:cloudflare": "cross-env CAD_FRONTEND_TARGET=cloudflare WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
        "test": "npm run typecheck && npm run build && npm run test:unit",
        "test:prepare": "node scripts/prepare-test-runtime.mjs",
        "test:unit": "node scripts/run-unit-tests.mjs",
        "test:runtime": "node scripts/run-unit-tests.mjs --inspect",
        "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
        "gateway": "node gateway/server.mjs",
        "services:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-web-cad-demo.ps1 -Action Start",
        "services:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-web-cad-demo.ps1 -Action Start -FrontendMode Development -GatewayMode Development",
        "services:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-web-cad-demo.ps1 -Action Status",
        "services:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-web-cad-demo.ps1 -Action Stop",
        "modeling-agent": "powershell -ExecutionPolicy Bypass -File scripts/start-modeling-agent.ps1",
        "build:worker": "powershell -ExecutionPolicy Bypass -File scripts/build-worker.ps1",
        "build:mesh-worker": "powershell -ExecutionPolicy Bypass -File scripts/build-mesh-worker.ps1",
        "test:geometry": "node scripts/run-unit-tests.mjs tests/geometry-api.test.mjs",
        "test:native": "node scripts/run-unit-tests.mjs --native",
        "test:storage": "node scripts/run-unit-tests.mjs tests/data-dir.test.mjs tests/data-directory-writer.test.mjs tests/data-writer-api.test.mjs tests/stop-test-child.test.mjs tests/idempotency-outcome-store.test.mjs tests/project-transactions.test.mjs tests/persistent-history.test.mjs",
        "test:ui": "node scripts/run-unit-tests.mjs --script scripts/verify-workbench.cjs",
        "test:interaction": "node scripts/run-unit-tests.mjs tests/grid-drag.test.mjs tests/pi-messages.test.mjs tests/pi-rpc-runtime.test.mjs tests/pi-cad-mcp-extension.test.mjs tests/pi-event-connection.test.mjs tests/pi-stream-protocol.test.mjs tests/pi-recovery-api.test.mjs",
        "test:source-restoration": "node scripts/run-unit-tests.mjs tests/source-access-gate.test.mjs tests/source-file-swap.test.mjs tests/source-restore-proof.test.mjs tests/source-restore-transactions.test.mjs tests/source-restore-native-integration.test.mjs tests/source-restore-service.test.mjs tests/source-restore-api.test.mjs tests/step-source-integrity.test.mjs",
        "test:ui:pi-recovery": "node scripts/run-unit-tests.mjs --script scripts/verify-pi-recovery.mjs",
        "test:ui:references": "node scripts/run-unit-tests.mjs --script scripts/verify-feature-repair.cjs",
        "test:ui:coordinates": "node scripts/run-unit-tests.mjs --script scripts/verify-coordinate-reference.cjs",
        "test:ui:generated": "node scripts/run-unit-tests.mjs --script scripts/verify-generated-topology.mjs",
        "test:ui:imported": "node scripts/run-unit-tests.mjs --script scripts/verify-imported-topology.mjs",
        "test:ui:constructed": "node scripts/run-unit-tests.mjs --script scripts/verify-constructed-topology.mjs",
        "test:ui:loft": "node scripts/run-unit-tests.mjs --script scripts/verify-real-loft.mjs",
        "test:ui:loft-holes": "node scripts/run-unit-tests.mjs --script scripts/verify-loft-holes.mjs",
        "test:ui:loft-references": "node scripts/run-unit-tests.mjs --script scripts/verify-loft-reference-repair.mjs",
        "test:ui:lifecycle": "node scripts/run-unit-tests.mjs --script scripts/verify-feature-lifecycle.mjs",
        "test:ui:curves": "node scripts/run-unit-tests.mjs --script scripts/verify-curve-sweep.mjs",
        "test:ui:sweep-references": "node scripts/run-unit-tests.mjs --script scripts/verify-sweep-reference-repair.mjs",
        "test:ui:property-sets": "node scripts/run-unit-tests.mjs --script scripts/verify-property-sets.mjs",
        "test:ui:measurements": "node scripts/run-unit-tests.mjs --script scripts/verify-measurements.mjs",
        "test:ui:loading": "node scripts/run-unit-tests.mjs --script scripts/verify-project-loading.mjs",
        "test:ui:step": "node scripts/run-unit-tests.mjs --script scripts/verify-step-tasks.mjs",
        "test:ui:step:legacy": "node scripts/run-unit-tests.mjs --script scripts/verify-step-import.mjs",
        "test:ui:sources": "node scripts/run-unit-tests.mjs --script scripts/verify-source-audit.mjs",
        "test:ui:source-restoration": "node scripts/run-unit-tests.mjs --script scripts/verify-source-restoration.mjs",
        "test:services": "node scripts/run-unit-tests.mjs --script scripts/verify-services.mjs",
        "typecheck": "tsc --noEmit --incremental false",
        "benchmark:spatial": "node scripts/benchmark-spatial.mjs",
        "benchmark:startup": "node scripts/benchmark-cold-start.mjs",
        "benchmark:mutations": "node scripts/benchmark-mutation-retention.mjs",
        "audit:project": "node scripts/audit-project-state.mjs",
        "diagnostics:export": "node scripts/export-diagnostics.mjs",
        "prebuild": "node scripts/clean-vite-temp.mjs"
    },
    "dependencies": {
        "next": "16.2.6",
        "react": "19.2.6",
        "react-dom": "19.2.6",
        "three": "^0.185.1"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "1.37.1",
        "@tailwindcss/postcss": "4.2.1",
        "@types/node": "22.19.19",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@types/three": "^0.185.1",
        "@vitejs/plugin-react": "6.0.2",
        "@vitejs/plugin-rsc": "0.5.26",
        "cross-env": "^10.1.0",
        "eslint": "9.39.4",
        "eslint-config-next": "16.2.6",
        "playwright": "1.62.1",
        "react-server-dom-webpack": "19.2.6",
        "tailwindcss": "4.2.1",
        "typescript": "5.9.3",
        "vinext": "0.0.50",
        "vite": "8.0.13",
        "wrangler": "4.92.0"
    },
    "type": "module"
}
