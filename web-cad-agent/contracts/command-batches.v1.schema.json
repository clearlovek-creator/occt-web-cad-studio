{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Web CAD Gateway Command Batch v1",
  "type": "object",
  "required": ["protocolVersion", "batchId", "documentId", "steps"],
  "properties": {
    "protocolVersion": {"const": 1},
    "batchId": {"type": "string", "minLength": 1, "maxLength": 160},
    "documentId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "baseRevision": {"type": "integer", "minimum": 0},
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "required": ["operation", "idempotencyKey"],
        "properties": {
          "stepId": {"type": "string", "maxLength": 100},
          "operation": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9_]*){1,3}$"},
          "requestId": {"type": "string"}, "idempotencyKey": {"type": "string", "minLength": 1},
          "inputs": {"type": "object"}, "parameters": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
